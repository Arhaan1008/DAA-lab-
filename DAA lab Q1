  code:

  
#include <stdio.h>
#include <math.h>
#include <stdlib.h>

typedef struct {
    char name[50];
    double value;
} Function;

int compare(const void *a, const void *b) {
    Function *x = (Function *)a;
    Function *y = (Function *)b;

    if (x->value > y->value)
        return 1;
    else if (x->value < y->value)
        return -1;
    return 0;
}

int main() {
    double n = 1000;

    Function f[] = {
        {"log2(n)", log2(n)},
        {"sqrt(12n)", sqrt(12*n)},
        {"nlog2(n)", n*log2(n)},
        {"100n^2+6n",100*n*n+6*n},
        {"n^0.51",pow(n,0.51)},
        {"n^2-324",n*n-324},
        {"50n^0.5",50*sqrt(n)},
        {"2n^3",2*pow(n,3)},
        {"3^n",pow(3,n)},
        {"2^(2n)",pow(2,2*n)},
        {"log2(n)",log2(n)}
    };

    int size = sizeof(f)/sizeof(f[0]);

    qsort(f,size,sizeof(Function),compare);

    printf("Increasing Order:\n");
    for(int i=0;i<size;i++)
        printf("%-15s %.3e\n",f[i].name,f[i].value);

    return 0;
}
