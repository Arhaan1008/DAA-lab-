void createPlotScript()
{
    FILE *gp;

    gp = fopen("merge_plot.gnuplot", "w");

    if (gp == NULL)
    {
        printf("Unable to create GNUplot script.\n");
        return;
    }

    fprintf(gp, "set title 'Merge Sort vs Modified Merge Sort'\n");
    fprintf(gp, "set xlabel 'Input Size (n)'\n");
    fprintf(gp, "set ylabel 'Number of Comparisons'\n");
    fprintf(gp, "set grid\n");
    fprintf(gp, "set key left top\n");
    fprintf(gp, "set datafile separator ','\n");

    fprintf(gp,
            "plot 'merge_comparison.csv' using 1:2 "
            "with linespoints title 'Merge Sort', "
            "'merge_comparison.csv' using 1:3 "
            "with linespoints title 'Modified Merge Sort'\n");

    fclose(gp);

    printf("GNUplot script generated.\n");
    printf("File: merge_plot.gnuplot\n");
}
