void generateRandomArray(int a[], int n)
{
    int i;

    for (i = 0; i < n; i++)
    {
        a[i] = rand() % 10000;
    }
}

void copyArray(int source[], int destination[], int n)
{
    int i;

    for (i = 0; i < n; i++)
    {
        destination[i] = source[i];
    }
}

long long mergeTwo(int a[], int temp[], int left, int mid, int right)
{
    int i = left;
    int j = mid + 1;
    int k = left;

    long long comparisons = 0;

    while (i <= mid && j <= right)
    {
        comparisons++;

        if (a[i] <= a[j])
        {
            temp[k] = a[i];
            i++;
        }
        else
        {
            temp[k] = a[j];
            j++;
        }

        k++;
    }

    while (i <= mid)
    {
        temp[k] = a[i];
        i++;
        k++;
    }

    while (j <= right)
    {
        temp[k] = a[j];
        j++;
        k++;
    }

    for (i = left; i <= right; i++)
    {
        a[i] = temp[i];
    }

    return comparisons;
}


long long mergeSort(int a[], int temp[], int left, int right)
{
    int mid;
    long long comparisons = 0;

    if (left < right)
    {
        mid = left + (right - left) / 2;

        comparisons += mergeSort(a, temp, left, mid);
        comparisons += mergeSort(a, temp, mid + 1, right);

        comparisons += mergeTwo(a, temp, left, mid, right);
    }

    return comparisons;
}

long long mergeThree(int a[], int temp[],
                     int left, int mid1,
                     int mid2, int right)
{
    int i = left;
    int j = mid1 + 1;
    int k = mid2 + 1;
    int p = left;

    long long comparisons = 0;

    while (i <= mid1 && j <= mid2 && k <= right)
