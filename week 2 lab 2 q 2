long long threeWayMergeSort(int a[], int temp[],int left, int right)
{
    int n;
    int third;
    int mid1;
    int mid2;

    long long comparisons = 0;

    if (left < right)
    {
        n = right - left + 1;

        third = n / 3;

        if (n < 3)
        {
            int mid = left + (right - left) / 2;

            comparisons +=
                threeWayMergeSort(a, temp, left, mid);

            comparisons +=
                threeWayMergeSort(a, temp, mid + 1, right);

            comparisons +=
                mergeTwo(a, temp, left, mid, right);

            return comparisons;
        }

        mid1 = left + third - 1;

        mid2 = left + 2 * third - 1;


        if (mid2 >= right)
        {
            mid2 = right - 1;
        }

        comparisons +=
            threeWayMergeSort(a, temp, left, mid1);

        comparisons +=
            threeWayMergeSort(a, temp, mid1 + 1, mid2);

        comparisons +=
            threeWayMergeSort(a, temp, mid2 + 1, right);

        comparisons +=
            mergeThree(a, temp,
                       left, mid1,
                       mid2, right);
    }

    return comparisons;
}

int isSorted(int a[], int n)
{
    int i;

    for (i = 1; i < n; i++)
    {
        if (a[i - 1] > a[i])
        {
            return 0;
        }
    }

    return 1;
}

