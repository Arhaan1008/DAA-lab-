void generate_csv()
{
    FILE *fp;
    int n;

    fp = fopen("dictionary_complexity.csv", "w");

    if (fp == NULL)
    {
        printf("\nError: Could not create CSV file.\n");
        return;
    }

    fprintf(fp,
        "n,"
        "UA_Search,SA_Search,SUL_Search,SSL_Search,DUL_Search,DSL_Search,"
        "UA_Insert,SA_Insert,SUL_Insert,SSL_Insert,DUL_Insert,DSL_Insert,"
        "UA_Delete,SA_Delete,SUL_Delete,SSL_Delete,DUL_Delete,DSL_Delete,"
        "UA_Max,SA_Max,SUL_Max,SSL_Max,DUL_Max,DSL_Max,"
        "UA_Min,SA_Min,SUL_Min,SSL_Min,DUL_Min,DSL_Min,"
        "UA_Pred,SA_Pred,SUL_Pred,SSL_Pred,DUL_Pred,DSL_Pred,"
        "UA_Succ,SA_Succ,SUL_Succ,SSL_Succ,DUL_Succ,DSL_Succ\n"
    );

    for (n = 10; n <= 1000; n += 10)
    {
        int logn = log2_count(n);

       
        fprintf(fp, "%d,", n);

        fprintf(fp, "%d,%d,%d,%d,%d,%d,",
                n, logn, n, n, n, n);

        /

        fprintf(fp, "%d,%d,%d,%d,%d,%d,",
                1, n, 1, n, 1, n);


        fprintf(fp, "%d,%d,%d,%d,%d,%d,",
                1, n, n, n, 1, 1);

        

        fprintf(fp, "%d,%d,%d,%d,%d,%d,",
                n, 1, n, n, n, n);

        

        fprintf(fp, "%d,%d,%d,%d,%d,%d,",
                n, 1, n, 1, n, 1);

        

        fprintf(fp, "%d,%d,%d,%d,%d,%d,",
                n, 1, n, n, n, 1);

        

        fprintf(fp, "%d,%d,%d,%d,%d,%d\n",
                n, 1, n, 1, n, 1);
    }

    fclose(fp);

    printf("\nCSV file created successfully!\n");
    printf("File name: dictionary_complexity.csv\n");
}

